# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_xxx
STRIPE_SECRET_KEY_TEST=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (Test Mode)
STRIPE_STARTER_PRICE_TEST=price_xxx  # $5.00 → 20 credits
STRIPE_POPULAR_PRICE_TEST=price_xxx  # $10.00 → 50 credits
STRIPE_PRO_PRICE_TEST=price_xxx      # $25.00 → 150 credits

# Stripe (Live Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_xxx
STRIPE_SECRET_KEY_LIVE=sk_live_xxx

# Stripe Price IDs (Live Mode)
STRIPE_STARTER_PRICE_LIVE=price_xxx  # $5.00 → 20 credits
STRIPE_POPULAR_PRICE_LIVE=price_xxx  # $10.00 → 50 credits
STRIPE_PRO_PRICE_LIVE=price_xxx      # $25.00 → 150 credits

# Note: Mode auto-detected based on NEXT_PUBLIC_VERCEL_ENV
# - preview = test mode
# - production = live mode
# - local dev = test mode

# Fashn API
FASHN_API_KEY=fa-xxx
FASHN_API_ENDPOINT=https://api.fashn.ai/v1

# Google Gemini API (Nano Banana)
GOOGLE_GEMINI_API_KEY=xxx

# Cloudflare R2 (Image Storage)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=fitcheck-bucket
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# App Domain
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000

# DataFast Analytics
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=dfid_8dDTTY4SDh54x43CILUSu
NEXT_PUBLIC_DATAFAST_DOMAIN=tryfitcheck.com

# App Store Links
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/id6738919443
NEXT_PUBLIC_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.wegalabs.fitcheck

# Node Environment
NODE_ENV=development
